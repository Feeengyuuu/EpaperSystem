# Public DNS name routed to this VPS. Do not include a scheme or path.
WEB_PORTAL_HOSTNAME=epaper.example.com

# Local image tag and narrowly scoped bind mounts.
# Replace both placeholders with the same clean Git SHA so build, up, backup,
# and restore always resolve one release revision.
WEB_PORTAL_IMAGE=epapersystem-web:REPLACE_WITH_GIT_SHA
WEB_PORTAL_GIT_REVISION=REPLACE_WITH_GIT_SHA
WEB_PORTAL_CONFIG_DIR=./config
WEB_PORTAL_PUBLICATION_DIR=./publication
WEB_PORTAL_WORKER_DATA_DIR=./worker-data
WEB_PORTAL_SECURITY_DIR=./security
WEB_PORTAL_PROVIDER_SECRETS_DIR=./provider-secrets
WEB_PORTAL_SESSION_KEY_FILE=./session-key/web_portal_secret_key

# Portal presentation settings. Credentials belong in their dedicated files.
WEB_PORTAL_TIMEZONE=America/Los_Angeles
WEB_PORTAL_PUBLICATION_HEALTH_CACHE_SECONDS=10

# Bounded immutable history. Increase only after sizing publication storage.
WEB_EDITION_RETENTION_PER_INSTANCE=32
WEB_CATALOG_RETENTION=64

# Optional advanced overrides; the built-in factories are used by default.
# WEB_PORTAL_PUBLICATIONS_FACTORY=web_portal.factories:create_reader
# WEB_PORTAL_WORKER_FACTORY=web_portal.factories:create_worker
