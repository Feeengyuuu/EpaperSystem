{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "epaper-vehicle-bridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "TESLA_AUDIENCE": "https://fleet-api.prd.na.vn.cloud.tesla.com",
    "TESLA_APP_DOMAIN": "epaper-vehicle-bridge.superxfy.workers.dev",
    "TESLA_REDIRECT_URI": "https://epaper-vehicle-bridge.superxfy.workers.dev/oauth/callback",
    "TESLA_OAUTH_SCOPES": "openid offline_access vehicle_device_data vehicle_location",
    "OAUTH_LAUNCH_TTL_SECONDS": "120",
    "OAUTH_SESSION_TTL_SECONDS": "600",
    "VEHICLE_SUMMARY_TTL_SECONDS": "900",
    "VEHICLE_SUMMARY_MAX_STALE_SECONDS": "86400"
  },
  "secrets": {
    "required": [
      "TESLA_CLIENT_ID",
      "TESLA_CLIENT_SECRET",
      "BRIDGE_ADMIN_TOKEN",
      "BRIDGE_READ_TOKEN",
      "TOKEN_ENCRYPTION_KEY_V1"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "VEHICLE_AUTH",
        "class_name": "VehicleAuthState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VehicleAuthState"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  }
}
