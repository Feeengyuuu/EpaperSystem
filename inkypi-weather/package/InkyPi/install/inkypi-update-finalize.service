[Unit]
Description=Finalize a recovered InkyPi update after service ordering settles
After=inkypi-update-recover.service lightdm.service inkypi.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/inkypi-update --finalize-recovery
TimeoutStartSec=300
UMask=0077

[Install]
WantedBy=multi-user.target
