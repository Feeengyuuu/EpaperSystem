{
  "schema_version": 2,
  "id": "ai_papers",
  "class": "AiPapers",
  "display_name": "AI 论文日报",
  "refresh_on_display": false,
  "recommended_refresh": {"interval": 3600},
  "capabilities": {
    "supports_live_refresh": false,
    "supports_presentation_refresh": false,
    "supports_day_night_theme": true,
    "supports_cached_display_redraw": true
  },
  "theme": {
    "presentation": "ui",
    "day": {"background": "#ffffff", "accent": "#ff9d00"},
    "night": {"background": "#000000", "accent": "#ffd21e"}
  }
}
